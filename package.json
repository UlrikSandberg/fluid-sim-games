{
  "name": "duck-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "node scripts/check-sim.ts",
    "test:determinism": "node scripts/determinism.ts",
    "test:acceptance": "node scripts/acceptance.ts",
    "test": "node scripts/determinism.ts && node scripts/acceptance.ts && node scripts/buoyancy.ts && node scripts/acceptance3d.ts && node scripts/buoyancy.ts --3d",
    "test:buoyancy": "node scripts/buoyancy.ts",
    "test:3d": "node scripts/acceptance3d.ts",
    "test:buoyancy3d": "node scripts/buoyancy.ts --3d",
    "test:gpu": "node scripts/gpu-check.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
